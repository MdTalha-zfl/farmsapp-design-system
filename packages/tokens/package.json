{
  "name": "@farmsapp/tokens",
  "version": "0.0.0",
  "description": "Primitive and semantic design tokens — Style Dictionary source, compiled to CSS custom properties and typed TS constants. See System Blueprint §05.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./css": "./build/css/tokens.css",
    "./package.json": "./package.json"
  },
  "files": ["build"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "style-dictionary build --config style-dictionary.config.mjs && rollup -c",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@farmsapp/eslint-config": "workspace:*",
    "typescript": "^5.7.0",
    "rollup": "^4.28.0",
    "style-dictionary": "^4.3.0"
  }
}
