{
  "name": "@farmsapp/tokens",
  "version": "0.0.0",
  "description": "Primitive and semantic design tokens — Style Dictionary source, compiled to CSS custom properties and typed TS constants. See System Blueprint §05.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./css": "./build/css/tokens.css",
    "./package.json": "./package.json"
  },
  "files": ["build"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/check-contrast.mjs && node scripts/build-tokens.mjs && node scripts/assemble-layers.mjs && rollup -c",
    "dev": "node scripts/watch-tokens.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:scales": "node scripts/generate-scale.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@farmsapp/eslint-config": "workspace:*",
    "typescript": "^5.7.0",
    "rollup": "^4.28.0",
    "style-dictionary": "^4.3.0",
    "culori": "^4.0.1"
  }
}
