{
  "name": "@farmsapp/utilities",
  "version": "0.1.0",
  "description": "Shared hooks (useId, useControllableState) and accessibility helpers — System Blueprint §04. RTL/dir utilities deliberately out of scope, see decisions/decision-cut-rtl-utilities.md.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@farmsapp/eslint-config": "workspace:*",
    "@types/react": "^18.3.0",
    "typescript": "^5.7.0",
    "rollup": "^4.28.0"
  }
}
