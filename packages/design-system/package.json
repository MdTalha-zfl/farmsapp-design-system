{
  "name": "@farmsapp/design-system",
  "version": "0.0.0",
  "description": "Box, Stack, Inline, Container, Text, Heading, Icon, VisuallyHidden, Button, Input, Dialog, Menu, and the rest of the component library — the single published package, merged from the former packages/primitives and packages/components. See decisions/decision-merge-components-into-design-system.md.",
  "type": "module",
  "sideEffects": ["./build/css/atomic.css"],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./css": "./build/css/atomic.css",
    "./package.json": "./package.json"
  },
  "files": ["build"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/generate-atomic-css.mjs && rollup -c",
    "dev": "node scripts/watch-atomic-css.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@farmsapp/icons": "workspace:*",
    "@farmsapp/tokens": "workspace:*",
    "@farmsapp/utilities": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@farmsapp/eslint-config": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "rollup": "^4.28.0",
    "storybook": "^10.5.10",
    "@storybook/react-vite": "^10.5.10"
  }
}
